{
  "name": "fhir-normalize",
  "version": "1.5.0",
  "description": "Ingest healthcare data in multiple formats (FHIR JSON, FHIR XML) and get back one standard shape: a FHIR R4 Bundle, plus a simplified view with FHIR choice types resolved.",
  "keywords": [
    "fhir",
    "hl7",
    "healthcare",
    "normalize",
    "r4",
    "interoperability",
    "typescript"
  ],
  "license": "MIT",
  "author": "Syed Ali Abbas Zaidi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syed-Ali-Abbas-Zaidi/fhir-normalize.git",
    "directory": "packages/fhir-normalize"
  },
  "homepage": "https://github.com/Syed-Ali-Abbas-Zaidi/fhir-normalize#readme",
  "bugs": {
    "url": "https://github.com/Syed-Ali-Abbas-Zaidi/fhir-normalize/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./simplified": {
      "import": {
        "types": "./dist/simplified.d.ts",
        "default": "./dist/simplified.js"
      },
      "require": {
        "types": "./dist/simplified.d.cts",
        "default": "./dist/simplified.cjs"
      }
    },
    "./deidentify": {
      "import": {
        "types": "./dist/deidentify.d.ts",
        "default": "./dist/deidentify.js"
      },
      "require": {
        "types": "./dist/deidentify.d.cts",
        "default": "./dist/deidentify.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "node scripts/prepack.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/fhir": "^0.0.44",
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
